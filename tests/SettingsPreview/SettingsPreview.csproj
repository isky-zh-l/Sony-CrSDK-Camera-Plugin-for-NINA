<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NinaApp Condition="'$(NinaApp)' == ''">$(NINA_APP)</NinaApp>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/nina/src/SonyA7V.Camera/JpegPreview.cs" Link="JpegPreview.cs" />
    <Compile Include="../../src/nina/src/SonyA7V.Camera/PluginSettings.cs" Link="PluginSettings.cs" />
    <ProjectReference Include="../../src/managed/src/SonyCamera.Client/SonyCamera.Client.csproj" />
    <Reference Include="$(NinaApp)/NINA.Core.dll" />
  </ItemGroup>
</Project>
