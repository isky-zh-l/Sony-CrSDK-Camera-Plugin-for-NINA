<UserControl x:Class="SonyA7V.Camera.SdkSetupView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:local="clr-namespace:SonyA7V.Camera" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="#E5EDF6">
 <UserControl.Resources><Style TargetType="Button"><Setter Property="Background" Value="#285E8B"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="4"/></Style></UserControl.Resources>
 <StackPanel Margin="18">
  <TextBlock Text="{local:Loc Ui041}" FontSize="17" FontWeight="SemiBold" Foreground="#E5EDF6"/>
  <TextBlock Margin="0,8,0,12" TextWrapping="Wrap" Foreground="#AABBCD" Text="{local:Loc Ui042}"/>
  <TextBlock Text="{local:Loc Ui043}" Foreground="#E5EDF6"/>
  <DockPanel><Button Content="{local:Loc Ui044}" DockPanel.Dock="Right" Click="Browse"/><TextBox x:Name="SdkPath" MinWidth="200" Foreground="Black" Background="White"/></DockPanel>
  <CheckBox x:Name="Elevate" Content="{local:Loc Ui045}"/>
  <TextBlock Margin="0,6,0,8" TextWrapping="Wrap" Foreground="#AABBCD" Text="{local:Loc Ui046}"/>
  <WrapPanel><Button x:Name="ImportButton" Content="{local:Loc Ui047}" Click="Import"/><Button x:Name="AutoButton" Content="{local:Loc Ui048}" Click="AutoConfigure"/><Button x:Name="VerifyButton" Content="{local:Loc Ui049}" Click="Verify"/></WrapPanel>
  <TextBlock x:Name="Status" Margin="0,10,0,8" TextWrapping="Wrap" Foreground="#96CCF6"/>
 </StackPanel>
</UserControl>
