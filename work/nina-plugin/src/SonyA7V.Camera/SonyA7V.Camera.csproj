<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.4.1.3</Version>
    <FileVersion>0.4.1.3</FileVersion>
    <AssemblyVersion>0.4.1.3</AssemblyVersion>
    <AssemblyTitle>Sony CrSDK Camera Plugin for N.I.N.A.</AssemblyTitle>
    <Company>isky</Company>
    <Description>N.I.N.A. camera driver for Sony ILCE-7M5 through the Sony Camera Remote SDK.</Description>
    <NinaApp Condition="'$(NinaApp)' == ''">$(NINA_APP)</NinaApp>
    <ClientRoot Condition="'$(ClientRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\csharp-client</ClientRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(NinaApp)\NINA.Core.dll;$(NinaApp)\NINA.Image.dll;$(NinaApp)\NINA.Plugin.dll;$(NinaApp)\NINA.Profile.dll;$(NinaApp)\NINA.Equipment.dll;$(NinaApp)\NINA.WPF.Base.dll;$(NinaApp)\NINA.Astrometry.dll;$(NinaApp)\NINA.dll"><Private>false</Private></Reference>
    <Reference Include="$(NinaApp)\System.Text.Json.dll"><Private>false</Private></Reference>
    <Reference Include="$(NinaApp)\System.Text.Encodings.Web.dll"><Private>false</Private></Reference>
    <Reference Include="$(NinaApp)\System.ComponentModel.Composition.dll"><Private>false</Private></Reference>
    <Reference Include="$(NinaApp)\Nito.AsyncEx*.dll"><Private>false</Private></Reference>
    <Reference Include="$(NinaApp)\CommunityToolkit.Mvvm.dll"><Private>false</Private></Reference>
    <!-- The managed client is deployed beside the plugin; it is a file reference so the
         plugin can be built without rebuilding the client solution. -->
    <Reference Include="$(ClientRoot)\src\SonyCamera.Client\bin\Release\net8.0\SonyCamera.Client.dll"><Private>true</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\assets\icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\config\settings.json" Link="settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckHost" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(NinaApp)\NINA.Plugin.dll')" Text="Set NINA_APP or -p:NinaApp to NINA 3.2.0.9001 app directory." />
    <Error Condition="!Exists('$(ClientRoot)\src\SonyCamera.Client\bin\Release\net8.0\SonyCamera.Client.dll')" Text="Build the managed client (work/csharp-client/build.ps1) before the plugin." />
  </Target>
</Project>

